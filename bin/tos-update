#!/usr/bin/env node
// 用法(詳見 README.md):
//   tos-update [--publish]                      自己的版本:抓背包 → data/ → (--publish 複製到網站目錄並 commit,不 push)
//   tos-update --uid <UID> --slug <代號> [--out <資料夾>] [--img-base <URL>]
//                                               朋友版:產生單一自含 out/<slug>/index.html,不碰網站目錄
//   --offline 不登入,用 .cache/profile.json(朋友版 .cache/profiles/<slug>.json)重建
// 設定優先序:旗標 > 環境變數(TOS_UID / TOS_SITE_DIR / TOS_IMG_BASE)> config.json(見 config.example.json)
// 其他旗標: --site <目錄> / --no-images / --refresh-monsters / --bump-sha
// 驗證碼從 stdin 讀(TTY 不回顯)或環境變數 TOS_AUTH;不接受命令列參數,也不寫入任何檔案或 log。
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { spawnSync } from 'node:child_process'
import { parseArgs, loadConfig, paths } from '../lib/config.mjs'
import { login, getProfile } from '../lib/api.mjs'
import { readAuth } from '../lib/auth.mjs'
import { rawBase } from '../lib/images.mjs'
import pin from '../lib/pin.json' with { type: 'json' }
import { updateFromProfile } from '../lib/update.mjs'
import { buildEmbedHtml, checkImgBase, injectPoolBase, checkPoolBase } from '../lib/embed.mjs'
import { syncPool } from '../lib/pool.mjs'

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const CACHE = path.join(ROOT, '.cache')
const DATA = path.join(ROOT, 'data')
const DOCS = process.env.TOS_DOCS_DIR || path.join(ROOT, 'docs') // 公開卡池站(GitHub Pages);TOS_DOCS_DIR 僅供測試

let parsed, cfg
try {
  parsed = parseArgs(process.argv.slice(2), ['offline', 'publish', 'no-images', 'refresh-monsters', 'bump-sha'], ['uid', 'slug', 'out', 'site', 'img-base', 'pool-base'])
  cfg = loadConfig({ flags: parsed.flags, root: ROOT })
} catch (e) { console.error(e.message); process.exit(2) }
const flagObj = parsed.flags
const flags = { has: k => flagObj[k.replace(/^--/, '')] === true }
const offline = flags.has('--offline')
const friend = cfg.slug !== null
{
  let fileUid = null
  try { fileUid = JSON.parse(fs.readFileSync(path.join(ROOT, 'config.json'), 'utf8')).uid } catch {}
  const own = String(process.env.TOS_UID ?? fileUid ?? '')
  if (!friend && flagObj.uid !== undefined && own && flagObj.uid !== own) { console.error('未指定 --slug 時 UID 只能取自 config.json/TOS_UID(避免別人的資料覆蓋主頁);朋友版請加 --slug'); process.exit(2) }
  if (friend && own && flagObj.uid === own) { console.error('朋友版的 --uid 不可與你自己的 UID 相同'); process.exit(2) }
}
if (friend && flags.has('--publish')) { console.error('朋友版(--slug)不會 publish 到網站目錄;產出在 out/<slug>/'); process.exit(2) }
if (parsed.positional.length) { console.error('不接受命令列參數(驗證碼請走 stdin 或 TOS_AUTH)'); process.exit(2) }
// 朋友版的卡圖網址先驗證,免得登入、抓完資料才失敗
let imgBase = null
if (friend) { try { imgBase = checkImgBase(cfg.imgBase) } catch (e) { console.error(e.message); process.exit(2) } }
let poolBase = null
if (flags.has('--publish')) { try { poolBase = checkPoolBase(cfg.poolBase) } catch (e) { console.error(e.message); process.exit(2) } }
const P = paths(ROOT, cfg.slug)

if (flags.has('--bump-sha')) {
  const r = await fetch(`https://api.github.com/repos/${pin.repo}/commits/HEAD`, { headers: { 'User-Agent': 'tos-backpack-personal/1.0' } })
  if (!r.ok) throw new Error('查詢最新 SHA 失敗 HTTP ' + r.status)
  pin.sha = (await r.json()).sha
  fs.writeFileSync(path.join(ROOT, 'lib/pin.json'), JSON.stringify(pin) + '\n')
  console.log('pin 已更新為 ' + pin.sha + '(本次執行仍用舊值載入的 module,請重跑一次)')
  process.exit(0)
}

fs.mkdirSync(CACHE, { recursive: true })
const log = m => console.log(m)

let profile
if (offline) {
  try { fs.chmodSync(P.profile, 0o600) } catch {}
  profile = JSON.parse(fs.readFileSync(P.profile, 'utf8'))
  log('離線模式:使用 ' + path.relative(ROOT, P.profile))
} else {
  if (friend && !flagObj.uid) { console.error('朋友版必須明確給 --uid <朋友的UID>(不使用 config.json 的預設 UID)'); process.exit(2) }
  if (!cfg.uid) { console.error('需要 UID:--uid <UID>、環境變數 TOS_UID 或 config.json'); process.exit(2) }
  const auth = await readAuth()
  if (!auth) { console.error('沒有收到驗證碼。離線重建用 --offline'); process.exit(2) }
  log('登入官方互助 API ...')
  const token = await login(cfg.uid, auth)
  profile = await getProfile(cfg.uid, token)
  fs.mkdirSync(path.dirname(P.profile), { recursive: true })
  fs.writeFileSync(P.profile, JSON.stringify(profile), { mode: 0o600 }) // 原始檔含個資,只放 .cache/(gitignore)
  fs.chmodSync(P.profile, 0o600)
}

const mFile = path.join(CACHE, 'monsterData.tsx')
if (!offline || flags.has('--refresh-monsters') || !fs.existsSync(mFile)) {
  log('下載最新 monsterData.tsx ...')
  const r = await fetch(rawBase() + 'src/constant/monsterData.tsx', { headers: { 'User-Agent': 'tos-backpack-personal/1.0' } })
  if (!r.ok) throw new Error('monsterData 下載失敗 HTTP ' + r.status)
  fs.writeFileSync(mFile, await r.text())
}

const { out, images } = await updateFromProfile({
  profile, monsterSrc: fs.readFileSync(mFile, 'utf8'),
  dataDir: friend ? P.friendDir : DATA, cardsDir: friend ? P.friendDir : P.cardsDir,
  skipImages: friend || flags.has('--no-images'), imgOpts: { log },
})
log(`cards.json:總張數 ${out.totalCards} / 獨立卡號 ${out.uniqueCards} / 未知卡號 ${out.unknownCount}`)
if (images) log(`圖片:需要 ${images.requested}、已有快取 ${images.cached}、新下載 ${images.downloaded}、repo 無圖 ${images.notFound.length}、失敗 ${images.failed.length}`)

if (friend) {
  const outDir = path.resolve(flagObj.out || path.join(ROOT, 'out', cfg.slug))
  const under = (p, base) => base && (p === base || p.startsWith(base + path.sep))
  const real = p => { try { return fs.realpathSync(p) } catch { return path.resolve(p) } }
  const o = real(outDir)
  if (cfg.siteDir && under(o, real(cfg.siteDir))) { console.error('--out 不可位於網站目錄內'); process.exit(2) }
  if (under(o, real(ROOT)) && !under(o, real(path.join(ROOT, 'out'))) && !under(o, real(path.join(ROOT, '.cache')))) { console.error('--out 在專案內時只能放在 out/ 或 .cache/ 之下'); process.exit(2) }
  const monsters = JSON.parse(fs.readFileSync(path.join(P.friendDir, 'monsters.json'), 'utf8'))
  fs.mkdirSync(outDir, { recursive: true })
  const html = buildEmbedHtml(fs.readFileSync(path.join(ROOT, 'web/index.html'), 'utf8'), out, monsters, imgBase)
  fs.writeFileSync(path.join(outDir, 'index.html'), html)
  log(`朋友版:${path.join(outDir, 'index.html')}(${(html.length / 1024).toFixed(0)} KB,卡圖載入自 ${imgBase})`)
}

if (!friend) {
  const st = syncPool({ dataDir: DATA, webDir: path.join(ROOT, 'web'), docsDir: DOCS })
  log(`卡池站 ${path.relative(ROOT, DOCS) || DOCS}:更新 ${st.copied} 個檔、未變 ${st.unchanged} 個(monsters.json、img/、查詢頁;請自行 commit/push)`)
}

if (flags.has('--publish')) {
  const SITE = cfg.siteDir
  if (!SITE) { console.error('--publish 需要網站目錄:--site <目錄>、TOS_SITE_DIR 或 config.json 的 siteDir'); process.exit(2) }
  fs.mkdirSync(SITE, { recursive: true })
  // 只複製自己的頁面與背包;monsters.json / img/ 改由 poolBase 指向的共用卡池站提供
  fs.writeFileSync(path.join(SITE, 'index.html'), injectPoolBase(fs.readFileSync(path.join(ROOT, 'web/index.html'), 'utf8'), poolBase))
  fs.copyFileSync(path.join(P.cardsDir, 'cards.json'), path.join(SITE, 'cards.json'))
  const git = (...a) => spawnSync('git', ['-C', SITE, ...a], { encoding: 'utf8' })
  const SCOPE = ['index.html', 'cards.json']
  const a = git('add', '--', ...SCOPE)
  if (a.status !== 0) { console.error('git add 失敗: ' + a.stderr); process.exit(1) }
  const c = git('commit', '-m', `tos-cards: 更新資料 ${out.updatedAt}(${out.uniqueCards} 種 / ${out.totalCards} 張)`, '--', ...SCOPE)
  if (c.status !== 0) {
    if (/nothing (added )?to commit|no changes added/.test(c.stdout + c.stderr)) log('資料無變動,沒有新 commit')
    else { console.error('git commit 失敗: ' + (c.stderr || c.stdout)); process.exit(1) }
  } else log(c.stdout.trim().split('\n')[0] + '\n(只 commit,未 push)')
}
